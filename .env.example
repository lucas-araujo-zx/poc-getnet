# O mesmo token da bancada da Almaviva. Fica só no servidor.
GETNET_LOGIN_TOKEN=

# Se GETNET_LOGIN_TOKEN estiver vazio, o servidor também aceita o token da Almaviva.
ALMAVIVA_LOGIN_TOKEN=

# Chave da conta ElevenLabs da Getnet. Deixe vazio até receber a chave deste cliente.
ELEVENLABS_API_KEY=

# Na Vercel, crie um Blob store privado e ligue ao projeto.
# O token é injetado automaticamente no deploy. Só preencha aqui para testar o Blob localmente.
BLOB_READ_WRITE_TOKEN=
